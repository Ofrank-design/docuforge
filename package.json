{
  "name": "docuforge-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "DocuForge — zero-config Markdown documentation site builder",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @docuforge/theme && npm run build -w docuforge",
    "build:theme": "npm run build -w @docuforge/theme",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/theme/tsconfig.json --noEmit && tsc -p tests/theme/tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "docuforge": "tsx packages/cli/src/index.ts",
    "example": "tsx packages/cli/src/index.ts build --config fixtures/sample-docs.config.json",
    "example:preview": "tsx packages/cli/src/index.ts preview --out .example-site"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "@types/lunr": "^2.3.7",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^3.0.2",
    "puppeteer-core": "^25.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
