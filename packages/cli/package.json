{
  "name": "docuforge",
  "version": "0.1.0",
  "description": "Zero-config Markdown documentation site builder",
  "type": "module",
  "license": "MIT",
  "bin": {
    "docuforge": "./dist/index.js"
  },
  "files": [
    "dist",
    "theme-assets",
    "starter"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-theme.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dompurify": "^3.4.17",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "highlight.js": "^11.12.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^26.1.0",
    "lunr": "^2.3.9",
    "picomatch": "^4.0.7",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^3.25.76"
  },
  "keywords": [
    "documentation",
    "markdown",
    "static-site",
    "docs",
    "search",
    "cli"
  ]
}
